; wpms_r1d_ew3.score — generated by hw/tools/gen_inject_scores.py from
; hw/l2/scores/wpms_r1d.score: the packet window replaced (Phase 6 error injection:
; the window stores into the inbox view (negative_tests N4): EW3). Everything below is the R1 dispatch score unchanged.
; ============================================================================
; wpms_r1d.score — the Phase 3 Core score, realization R1 in DISPATCH form
; (SILICON_BRIEF Phase 3; Deliverable 3 §3; W-R17; ruled forms of SD-05/SD-14)
;
; Eight unrolled packet positions POS0..POS7, each closed by a QUEUED Jump to the
; next position (POS7 -> HK): a queued Jump fires at Stay-timeup with no clock
; between packets (g = 0; Phase 1 SV-5b). The sweep's P selects WHERE the chain
; is entered: position 8-P, so exactly P packets play before HK. The entry is
; chosen one sweep ahead, in housekeeping: after BCP has landed the new
; SWEEP.a, the window program wpms_housekeeping_dispatch.pfasm writes
; JumpVal = TAIL_BASE + 16·P, and the background indirect Jump below (JumpInd)
; lands on TAIL_P, whose queued Jump goes, at the housekeeping timeup, to
; SLEEP_P — the Branch-0 wait placed right in front of POS(8-P) (SLEEP_0 in
; front of HK). At the strobe SLEEP_P falls through into its position: T_wake
; is one clock, and no conditional transfer is taken anywhere, so the Core's
; holding register is never used (no auto-save, no stack: SD-05 does not arise).
;
; Why not the sketch's conditional form: a queued Branch not taken resumes at
; Branch + 1 — the packet's own Stay, run again (SD-05 b) — and a taken one
; auto-saves (SD-05 a). The computed dispatch is a BACKGROUND one (W-T3
; restricts only the foreground) and uses JumpVal, lane 5, as Register Map v0.3
; §2 provides ("BG computed dispatch only"). No lane but STROBE is consulted.
;
; Layout: 0x000 reset entry · SLEEP_0 + HK · SLEEP_8+POS0 … SLEEP_1+POS7 ·
; tails at 0x300 + 16·P (13 unused words each) · trap at 0x3FF.
; License: MIT (Layer 3).
; ============================================================================
.depth  1024
.trap   0x3FF                   ; = TRAP_ADDR of wpms_l2_top
.window PKT inject_ew3.pfasm
.window HKD ../../l2/programs/wpms_housekeeping_dispatch.pfasm
.equ    N_MIN   32              ; operand only: the packet length comes from stay_value
.equ    T_HK    13              ; Deliverable 3 §9

        NOP                                     ; 0x000 reset entry (P = 0 after reset, CR5-R1)
SLEEP_0: Branch 0                               ; wait for the strobe (lane STROBE: CSEL 0 everywhere)
HK:     StaySet                                 ; TS_PKT = 0: StayVal.p = 0, the literal T_HK applies
        Window  HKD                             ; BCP · status -> JumpVal = TAIL_BASE + 16 P
        JumpInd                                 ; background computed dispatch -> TAIL_P
SLEEP_8: Branch 0                               ; P = 8: the chain is entered here
POS0:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS1                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_7: Branch 0                               ; P = 7: the chain is entered here
POS1:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS2                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_6: Branch 0                               ; P = 6: the chain is entered here
POS2:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS3                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_5: Branch 0                               ; P = 5: the chain is entered here
POS3:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS4                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_4: Branch 0                               ; P = 4: the chain is entered here
POS4:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS5                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_3: Branch 0                               ; P = 3: the chain is entered here
POS5:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS6                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_2: Branch 0                               ; P = 2: the chain is entered here
POS6:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    POS7                    ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

SLEEP_1: Branch 0                               ; P = 1: the chain is entered here
POS7:   StaySet                 PKT             ; TS_PKT = 1: packet_start, StayVal.p = N
        Window  PKT                             ; 25 Formation instructions (CUR alias)
        ProgEnd
        Jump    HK                      ; queued: fires at Stay-timeup, gap-free
        Stay    N_MIN           PKT             ; length from stay_value (N of the block)

.org    0x300
TAIL_0: ProgEnd                                ; next sweep plays P = 0
        Jump    SLEEP_0                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x310
TAIL_1: ProgEnd                                ; next sweep plays P = 1
        Jump    SLEEP_1                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x320
TAIL_2: ProgEnd                                ; next sweep plays P = 2
        Jump    SLEEP_2                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x330
TAIL_3: ProgEnd                                ; next sweep plays P = 3
        Jump    SLEEP_3                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x340
TAIL_4: ProgEnd                                ; next sweep plays P = 4
        Jump    SLEEP_4                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x350
TAIL_5: ProgEnd                                ; next sweep plays P = 5
        Jump    SLEEP_5                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x360
TAIL_6: ProgEnd                                ; next sweep plays P = 6
        Jump    SLEEP_6                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x370
TAIL_7: ProgEnd                                ; next sweep plays P = 7
        Jump    SLEEP_7                 ; queued: at the housekeeping timeup
        Stay    T_HK

.org    0x380
TAIL_8: ProgEnd                                ; next sweep plays P = 8
        Jump    SLEEP_8                 ; queued: at the housekeeping timeup
        Stay    T_HK
